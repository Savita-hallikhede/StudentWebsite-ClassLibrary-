@using ServiceContracts.DTO
@model List<StdResponse>


<html>
<head>
    <link rel="stylesheet" href="~/bootstrap-4.0.0-dist/css/bootstrap.min.css" />
    

   
</head>

<body>
 
    <h2><center>Student Data</center></h2>

    <table class="table table-dark">
        
        <thead>
            <tr>
                <th>StdId</th>
                <th>StdName</th>
                <th>StdDprt</th>
                <th>ClgId</th>
                <th>DOB</th>
                <th>Address</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.StdId</td>
                    <td>@student.StdName</td>
                    <td>@student.StdDprt</td>
                    <td>@student.ClgId</td>
                    <td>@student.DOB</td>
                    <td>@student.Address</td>
                </tr>
            }
        </tbody>
    </table>
   

    <div class="mt-3 text-center">
        <a href="/Std/Add" class="btn btn-success">
            ➕ Add
        </a>
      @*  <button class="btn btn-success mr-2">➕ Add</button> *@
        <button class="btn btn-primary mr-2">💾 Save</button>
        <button class="btn btn-warning mr-2">✏ Update</button>
        <button class="btn btn-danger">🗑 Delete</button>

    </div>

   
</body>
</html>